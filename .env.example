# انسخ هذا الملف إلى .env في الاستضافة ولا ترفعه لأي مستودع
PORT=3000
DB_FILE=/var/data/data.db
APP_URL=https://example.com
TRUST_PROXY=1
ADMIN_EMAIL=you@example.com
# البريد (استعادة كلمة المرور وإشعارات الطلبات)
RESEND_API_KEY=
MAIL_FROM=المساعد <noreply@example.com>
# بوابة هلا
HALA_PAYMENT_URL=
HALA_WEBHOOK_SECRET=
# النسخ الاحتياطي
BACKUP_DIR=/var/data/backups
BACKUP_EVERY_SECONDS=86400
BACKUP_KEEP=14

# إشعارات الدفع (Web Push): ولّدها مرة واحدة بالأمر الموجود في README
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# مركز الذكاء (اختياري)
# AI_DISABLED=1        # إيقاف طارئ مفروض من الخادم
# AI_SCHEDULER=0       # إيقاف المجدول الآلي
# AI_TICK_SECONDS=60
