# انسخ هذا الملف إلى .env في الاستضافة ولا ترفعه لأي مستودع
PORT=3000
DB_FILE=/var/data/data.db
APP_URL=https://example.com
TRUST_PROXY=1
ADMIN_EMAIL=you@example.com
ADMIN_SETUP_TOKEN=ضع-رمزًا-عشوائيًا-طويلًا
# البريد (استعادة كلمة المرور وإشعارات الطلبات)
RESEND_API_KEY=
MAIL_FROM=المساعد <noreply@example.com>
# بوابة هلا
HALA_PAYMENT_URL=
HALA_WEBHOOK_SECRET=
# النسخ الاحتياطي
BACKUP_DIR=/var/data/backups
BACKUP_EVERY_SECONDS=86400
BACKUP_KEEP=14

# إشعارات الدفع (Web Push): ولّدها مرة واحدة بالأمر الموجود في README
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# تخزين الفيديوهات الكبيرة خارجيًا (اختياري، متوافق مع S3: R2 أو S3 أو B2)
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=musaed-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_VHOST=0
